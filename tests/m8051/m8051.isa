AC_ISA(m8051) {

  ac_format Type_1B = "%op1:5 %rn1:3";
  ac_format Type_2B = "%op2:8 %imm2:8";
  ac_format Type_2BR = "%op3:5 %rn3:3 %imm3:8";
  ac_format Type_REL = "%op4:8 %offset4:8:s";
  ac_format Type_DJNZ = "%op5:5 %rn5:3 %offset5:8:s";
  ac_format Type_HLT = "%op6:8";

  ac_instr<Type_1B> add_a_rn, sub_a_rn, anl_a_rn, orl_a_rn, xrl_a_rn, mov_a_rn, mov_rn_a, inc_rn, dec_rn;
  ac_instr<Type_2B> mov_a_imm, add_a_imm;
  ac_instr<Type_2BR> mov_rn_imm;
  ac_instr<Type_REL> sjmp, jz, jnz;
  ac_instr<Type_DJNZ> djnz_rn;
  ac_instr<Type_HLT> halt;

  ac_asm_map reg {
    "$"[0..7] = [0..7];
    "r"[0..7] = [0..7];
  }

  ISA_CTOR(m8051) {
    add_a_rn.set_asm("add a, %rn1");
    add_a_rn.set_decoder(op1 = 0x05);

    sub_a_rn.set_asm("subb a, %rn1");
    sub_a_rn.set_decoder(op1 = 0x13);

    anl_a_rn.set_asm("anl a, %rn1");
    anl_a_rn.set_decoder(op1 = 0x0B);

    orl_a_rn.set_asm("orl a, %rn1");
    orl_a_rn.set_decoder(op1 = 0x09);

    xrl_a_rn.set_asm("xrl a, %rn1");
    xrl_a_rn.set_decoder(op1 = 0x0D);

    mov_a_rn.set_asm("mov a, %rn1");
    mov_a_rn.set_decoder(op1 = 0x1D);

    mov_rn_a.set_asm("mov %rn1, a");
    mov_rn_a.set_decoder(op1 = 0x1F);

    inc_rn.set_asm("inc %rn1");
    inc_rn.set_decoder(op1 = 0x01);

    dec_rn.set_asm("dec %rn1");
    dec_rn.set_decoder(op1 = 0x03);

    mov_a_imm.set_asm("mov a, #%imm2");
    mov_a_imm.set_decoder(op2 = 0x74);

    add_a_imm.set_asm("add a, #%imm2");
    add_a_imm.set_decoder(op2 = 0x24);

    mov_rn_imm.set_asm("mov %rn3, #%imm3");
    mov_rn_imm.set_decoder(op3 = 0x0F);

    sjmp.set_asm("sjmp %offset4");
    sjmp.set_decoder(op4 = 0x80);

    jz.set_asm("jz %offset4");
    jz.set_decoder(op4 = 0x60);

    jnz.set_asm("jnz %offset4");
    jnz.set_decoder(op4 = 0x70);

    djnz_rn.set_asm("djnz %rn5, %offset5");
    djnz_rn.set_decoder(op5 = 0x1B);

    halt.set_asm("halt");
    halt.set_decoder(op6 = 0xA5);
  };
};
