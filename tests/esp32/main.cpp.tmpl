const char *project_name="esp32";
const char *project_file="esp32.ac";
const char *archc_version="2.4.1";
const char *archc_options="-nw -nci ";

#include  <iostream>
#include  <systemc.h>
#include  "ac_stats_base.H"
#include  "esp32.H"



int sc_main(int ac, char *av[])
{

  //!  ISA simulator
  esp32 esp32_proc1("esp32");

#ifdef AC_DEBUG
  ac_trace("esp32_proc1.trace");
#endif 

  esp32_proc1.init(ac, av);
  esp32_proc1.set_prog_args();
  cerr << endl;

  sc_start();

  esp32_proc1.PrintStat();
  cerr << endl;

#ifdef AC_STATS
  ac_stats_base::print_all_stats(std::cerr);
#endif 

#ifdef AC_DEBUG
  ac_close_trace();
#endif 

  return esp32_proc1.ac_exit_status;
}
