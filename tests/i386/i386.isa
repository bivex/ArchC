AC_ISA(i386) {

  ac_format Type_RR  = "%opcode:8 %mod:2 %reg:3 %rm:3 %pad:16";
  ac_format Type_RI  = "%opcode:8 %reg:3 %pad:5 %imm:16:s";
  ac_format Type_RM  = "%opcode:8 %mod:2 %reg:3 %rm:3 %disp:16:s";
  ac_format Type_J   = "%opcode:8 %offset:24:s";
  ac_format Type_HLT = "%opcode:8 %pad:24";

  ac_instr<Type_RR>  add_rr, sub_rr, and_rr, or_rr, xor_rr, mov_rr;
  ac_instr<Type_RI>  mov_ri, add_ri, sub_ri, cmp_ri;
  ac_instr<Type_RM>  mov_rm, mov_mr;
  ac_instr<Type_J>   jmp, jne, je;
  ac_instr<Type_HLT> hlt;

  ac_asm_map reg {
    "%"[0..7] = [0..7];
    "eax" = 0;
    "ecx" = 1;
    "edx" = 2;
    "ebx" = 3;
    "esp" = 4;
    "ebp" = 5;
    "esi" = 6;
    "edi" = 7;
  }

  ISA_CTOR(i386) {
    add_rr.set_asm("add %rm, %reg");
    add_rr.set_decoder(opcode = 0x01);

    sub_rr.set_asm("sub %rm, %reg");
    sub_rr.set_decoder(opcode = 0x29);

    and_rr.set_asm("and %rm, %reg");
    and_rr.set_decoder(opcode = 0x21);

    or_rr.set_asm("or %rm, %reg");
    or_rr.set_decoder(opcode = 0x09);

    xor_rr.set_asm("xor %rm, %reg");
    xor_rr.set_decoder(opcode = 0x31);

    mov_rr.set_asm("mov %rm, %reg");
    mov_rr.set_decoder(opcode = 0x89);

    mov_ri.set_asm("mov %imm, %reg");
    mov_ri.set_decoder(opcode = 0xB8);

    add_ri.set_asm("add %imm, %reg");
    add_ri.set_decoder(opcode = 0x81);

    sub_ri.set_asm("sub %imm, %reg");
    sub_ri.set_decoder(opcode = 0x83);

    cmp_ri.set_asm("cmp %imm, %reg");
    cmp_ri.set_decoder(opcode = 0x3D);

    mov_rm.set_asm("mov %disp(%rm), %reg");
    mov_rm.set_decoder(opcode = 0x8B);

    mov_mr.set_asm("mov %reg, %disp(%rm)");
    mov_mr.set_decoder(opcode = 0x88);

    jmp.set_asm("jmp %offset");
    jmp.set_decoder(opcode = 0xE9);

    jne.set_asm("jne %offset");
    jne.set_decoder(opcode = 0x75);

    je.set_asm("je %offset");
    je.set_decoder(opcode = 0x74);

    hlt.set_asm("hlt");
    hlt.set_decoder(opcode = 0xF4);
  };
};
